<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and folders outside public
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|pnpm-lock\.yaml|artisan|bootstrap\/cache) - [F,L,NC]

    # Redirect requests to the public directory dynamically
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Options & Security
Options -Indexes +FollowSymLinks

